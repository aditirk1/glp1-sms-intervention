# Groq powers the plateau message generator (llama3-8b-8192).
# Get a free key at https://console.groq.com — no credit card required.
# Leave it blank and the plateau branch falls back to a safe static message.
GROQ_API_KEY=

DATABASE_URL=sqlite:///./GoaLPost¹.db
API_BASE_URL=http://localhost:8000

# Background APScheduler. Leave false for local demos with `uvicorn --reload`
# (the reloader can start two schedulers). Drive the loop with the dashboard
# "Run scheduler tick" button or: curl -X POST localhost:8000/scheduler/tick
ENABLE_SCHEDULER=false

# Send window in local wall-clock hours (inclusive start, exclusive end).
# Widen for evening demos if needed, e.g. SEND_WINDOW_END_HOUR=24
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=20

# No Twilio keys are needed for the demo build: services/sms_sender.py logs
# messages instead of sending them.
# For production SMS deployment add:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
