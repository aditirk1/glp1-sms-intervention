# Groq powers the plateau message generator (llama3-8b-8192).
# Get a free key at https://console.groq.com — no credit card required.
# Leave it blank and the plateau branch falls back to a safe static message.
GROQ_API_KEY=

DATABASE_URL=sqlite:///./GoaLPost¹.db
API_BASE_URL=http://localhost:8000

# No Twilio keys are needed for the demo build: services/sms_sender.py logs
# messages instead of sending them.
# For production SMS deployment add:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
